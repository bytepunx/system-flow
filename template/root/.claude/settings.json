{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__flai__.*",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(flai guard 2>&1); [ $? -eq 2 ] || exit 0; echo \"$out\" >&2; exit 2"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$FLAI_ROLE\" = plan ] || exit 0; out=$(flai guard 2>&1); [ $? -eq 2 ] || exit 0; echo \"$out\" >&2; exit 2"
          }
        ]
      }
    ]
  }
}
