version: 1
name: {{ .project_name | quote }}
key: {{ .project_key | quote }}
description: {{ .description | quote }}
owner: {{ .owner | quote }}
repo: {{ .repo_url | quote }}
template:
  repo: {{ .template.repo | quote }}
  ref: {{ .template.ref | quote }}
  version: {{ .template.version | quote }}
  applied: {{ .now }}
layout:
  design: {{ .layout.design }}
  docs: {{ .layout.docs }}
  wip: {{ .layout.wip }}
projects: []
dashboard:
  image: ghcr.io/bytepunx/flaiover
  tag: latest
  port: 4242
  bind: 0.0.0.0 # 127.0.0.1 to keep the dashboard on this host only
tests: # the test tiers, cheapest first, that flai test runs for the paths each selects; all_only runs only under --all
  - name: test
    command: [scripts/test.sh]
    paths: ["**"]
    format: plain
  - name: integration
    command: [scripts/integration.sh]
    format: plain
    all_only: true
  - name: smoke
    command: [scripts/smoke.sh]
    format: plain
    all_only: true
claims:
  shared: # paths many stories change in their own sections or new files: an overlap inside one holds no story; flai shared edits them
    - {{ .layout.design }}/adrs
    - {{ .layout.design }}/issues
