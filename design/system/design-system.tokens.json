              "on-primary": { "$value": { "colorSpace": "srgb", "components": [0.059, 0.09, 0.165], "hex": "#0f172a" } },
              "secondary": { "$value": { "colorSpace": "srgb", "components": [0.796, 0.835, 0.882], "hex": "#cbd5e1" } },
              "on-secondary": { "$value": { "colorSpace": "srgb", "components": [0.059, 0.09, 0.165], "hex": "#0f172a" } },
              "focus": { "$value": { "colorSpace": "srgb", "components": [0.376, 0.647, 0.98], "hex": "#60a5fa" } },
              "success": { "$value": { "colorSpace": "srgb", "components": [0.29, 0.871, 0.502], "hex": "#4ade80" } },
              "success-soft": { "$value": { "colorSpace": "srgb", "components": [0.02, 0.18, 0.086], "hex": "#052e16" } },
              "warning": { "$value": { "colorSpace": "srgb", "components": [0.984, 0.749, 0.141], "hex": "#fbbf24" } },
              "warning-soft": { "$value": { "colorSpace": "srgb", "components": [0.271, 0.102, 0.012], "hex": "#451a03" } },
              "danger": { "$value": { "colorSpace": "srgb", "components": [0.973, 0.443, 0.443], "hex": "#f87171" } },
              "danger-soft": { "$value": { "colorSpace": "srgb", "components": [0.271, 0.039, 0.039], "hex": "#450a0a" } },
              "info": { "$value": { "colorSpace": "srgb", "components": [0.376, 0.647, 0.98], "hex": "#60a5fa" } },
              "info-soft": { "$value": { "colorSpace": "srgb", "components": [0.09, 0.145, 0.329], "hex": "#172554" } }
            },
            "shadow": {
