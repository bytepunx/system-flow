            ],
            "set": true
          },
          { "key": "kluster.deploy", "kind": "command", "meaning": "The command that deploys a build into the namespace FLAI_KLUSTER_NAMESPACE names.", "value": ["scripts/kluster-deploy.sh"], "set": true },
          { "key": "kluster.teardown", "kind": "command", "meaning": "The command that removes what deploy made outside the namespace.", "value": ["scripts/kluster-teardown.sh"], "set": true },
