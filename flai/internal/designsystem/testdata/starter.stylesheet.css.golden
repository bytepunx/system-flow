/* Generated by flai design css --write from design/system/design-system.tokens.json.
   Do not edit: change the tokens and run flai design css --write again. */

@custom-variant dark (&:where([data-theme='dark'], [data-theme='dark'] *));

@theme {
  --color-background: #ffffff;
  --color-surface: #f8fafc;
  --color-text: #0f172a;
  --color-text-muted: #475569;
  --color-border: #848e9f;
  --color-primary: #2563eb;
  --color-on-primary: #ffffff;
  --color-secondary: #475569;
  --color-on-secondary: #ffffff;
  --color-focus: #2563eb;
  --color-success: #15803d;
  --color-success-soft: #f0fdf4;
  --color-warning: #b45309;
  --color-warning-soft: #fffbeb;
  --color-danger: #b91c1c;
  --color-danger-soft: #fef2f2;
  --color-info: #1d4ed8;
  --color-info-soft: #eff6ff;
  --font-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  --text-xs: 0.75rem;
  --text-xs--line-height: 1.333;
  --text-sm: 0.875rem;
  --text-sm--line-height: 1.429;
  --text-base: 1rem;
  --text-base--line-height: 1.5;
  --text-lg: 1.125rem;
  --text-lg--line-height: 1.556;
  --text-xl: 1.25rem;
  --text-xl--line-height: 1.4;
  --text-2xl: 1.5rem;
  --text-2xl--line-height: 1.333;
  --text-3xl: 1.875rem;
  --text-3xl--line-height: 1.2;
  --text-4xl: 2.25rem;
  --text-4xl--line-height: 1.111;
  --spacing: 0.25rem;
  --radius-sm: 0.25rem;
  --radius-md: 0.375rem;
  --radius-lg: 0.5rem;
  --shadow-sm: 0px 1px 3px 0px #0000001a, 0px 1px 2px -1px #0000001a;
  --shadow-md: 0px 4px 6px -1px #0000001a, 0px 2px 4px -2px #0000001a;
  --shadow-lg: 0px 10px 15px -3px #0000001a, 0px 4px 6px -4px #0000001a;
}

[data-theme='dark'] {
  --color-background: #0f172a;
  --color-surface: #1e293b;
  --color-text: #f1f5f9;
  --color-text-muted: #94a3b8;
  --color-border: #64748b;
  --color-primary: #60a5fa;
  --color-on-primary: #0f172a;
  --color-secondary: #cbd5e1;
  --color-on-secondary: #0f172a;
  --color-focus: #60a5fa;
  --color-success: #4ade80;
  --color-success-soft: #052e16;
  --color-warning: #fbbf24;
  --color-warning-soft: #451a03;
  --color-danger: #f87171;
  --color-danger-soft: #450a0a;
  --color-info: #60a5fa;
  --color-info-soft: #172554;
  --shadow-sm: 0px 1px 3px 0px #00000066, 0px 1px 2px -1px #00000066;
  --shadow-md: 0px 4px 6px -1px #00000066, 0px 2px 4px -2px #00000066;
  --shadow-lg: 0px 10px 15px -3px #00000066, 0px 4px 6px -4px #00000066;
}
