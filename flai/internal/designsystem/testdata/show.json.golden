  "problems": [],
  "css": ":root {\n  --color-background: #ffffff;\n  --color-surface: #f5f5f7;\n  --color-text: oklch(21% 0.02 265);\n  --color-text-muted: oklch(45% 0.02 265);\n  --color-border: #ccccd1;\n  --color-primary: oklch(52% 0.18 255);\n  --color-on-primary: #ffffff;\n  --color-secondary: oklch(45% 0.05 200);\n  --color-on-secondary: #ffffff;\n  --color-focus: oklch(60% 0.2 255);\n  --color-success: oklch(50% 0.13 150);\n  --color-success-soft: oklch(95% 0.04 150);\n  --color-warning: oklch(55% 0.12 70);\n  --color-warning-soft: oklch(96% 0.05 90);\n  --color-danger: oklch(52% 0.19 25);\n  --color-danger-soft: oklch(95% 0.03 25);\n  --color-info: oklch(50% 0.12 240);\n  --color-info-soft: oklch(95% 0.03 240);\n  --color-scrim: #00000066;\n  --color-link: oklch(52% 0.18 255);\n  --font-sans: \"Inter Variable\", Inter, ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\";\n  --font-mono: \"JetBrains Mono\", ui-monospace, monospace;\n  --text-xs: 0.75rem;\n  --text-xs--line-height: 1.333;\n  --text-sm: 0.875rem;\n  --text-sm--line-height: 1.25rem;\n  --text-base: 1rem;\n  --text-base--line-height: 1.5;\n  --text-base--font-weight: 400;\n  --text-base--letter-spacing: 0px;\n  --text-lg: 1.125rem;\n  --text-xl: 1.25rem;\n  --text-xl--line-height: 1.4;\n  --text-xl--font-weight: 600;\n  --text-2xl: 1.5rem;\n  --text-2xl--line-height: 1.333;\n  --text-3xl: 30px;\n  --text-3xl--line-height: 1.2;\n  --text-4xl: 2.25rem;\n  --text-4xl--line-height: 1.111;\n  --text-4xl--letter-spacing: -0.025rem;\n  --spacing: 0.25rem;\n  --radius-sm: 0.25rem;\n  --radius-md: 0.375rem;\n  --radius-lg: 8px;\n  --shadow-sm: 0px 1px 2px 0px #0000000d;\n  --shadow-md: 0px 4px 6px -1px oklch(0% 0 none / 0.1), 0px 2px 4px -2px oklch(0% 0 none / 0.1);\n  --shadow-lg: 0px 10px 15px -3px #0000001a;\n  --shadow-inner: inset 0px 2px 4px 0px #0000000d;\n}\n\n[data-theme='dark'] {\n  --color-background: oklch(18% 0.02 265);\n  --color-surface: oklch(23% 0.02 265);\n  --color-text: #f5f5f7;\n  --color-text-muted: oklch(75% 0.02 265);\n  --color-border: oklch(35% 0.02 265);\n  --color-primary: oklch(72% 0.15 255);\n  --color-on-primary: oklch(18% 0.02 265);\n  --color-secondary: oklch(45% 0.05 200);\n  --color-on-secondary: #ffffff;\n  --color-focus: oklch(60% 0.2 255);\n  --color-success: oklch(50% 0.13 150);\n  --color-success-soft: oklch(95% 0.04 150);\n  --color-warning: oklch(55% 0.12 70);\n  --color-warning-soft: oklch(96% 0.05 90);\n  --color-danger: oklch(70% 0.3 25);\n  --color-danger-soft: oklch(28% 0.06 25);\n  --color-info: oklch(50% 0.12 240);\n  --color-info-soft: oklch(95% 0.03 240);\n  --color-scrim: #00000066;\n  --color-link: oklch(72% 0.15 255);\n  --font-sans: \"Inter Variable\", Inter, ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\";\n  --font-mono: \"JetBrains Mono\", ui-monospace, monospace;\n  --text-xs: 0.75rem;\n  --text-xs--line-height: 1.333;\n  --text-sm: 0.875rem;\n  --text-sm--line-height: 1.25rem;\n  --text-base: 1rem;\n  --text-base--line-height: 1.5;\n  --text-base--font-weight: 400;\n  --text-base--letter-spacing: 0px;\n  --text-lg: 1.125rem;\n  --text-xl: 1.25rem;\n  --text-xl--line-height: 1.4;\n  --text-xl--font-weight: 600;\n  --text-2xl: 1.5rem;\n  --text-2xl--line-height: 1.333;\n  --text-3xl: 30px;\n  --text-3xl--line-height: 1.2;\n  --text-4xl: 2.25rem;\n  --text-4xl--line-height: 1.111;\n  --text-4xl--letter-spacing: -0.025rem;\n  --spacing: 0.25rem;\n  --radius-sm: 0.25rem;\n  --radius-md: 0.375rem;\n  --radius-lg: 8px;\n  --shadow-sm: 0px 1px 2px 0px #0000000d;\n  --shadow-md: 0px 4px 6px -1px oklch(0% 0 none / 0.5);\n  --shadow-lg: 0px 10px 15px -3px #0000001a;\n  --shadow-inner: inset 0px 2px 4px 0px #0000000d;\n}\n",
  "tailwind": "@custom-variant dark (\u0026:where([data-theme='dark'], [data-theme='dark'] *));\n\n@theme {\n  --color-background: #ffffff;\n  --color-surface: #f5f5f7;\n  --color-text: oklch(21% 0.02 265);\n  --color-text-muted: oklch(45% 0.02 265);\n  --color-border: #ccccd1;\n  --color-primary: oklch(52% 0.18 255);\n  --color-on-primary: #ffffff;\n  --color-secondary: oklch(45% 0.05 200);\n  --color-on-secondary: #ffffff;\n  --color-focus: oklch(60% 0.2 255);\n  --color-success: oklch(50% 0.13 150);\n  --color-success-soft: oklch(95% 0.04 150);\n  --color-warning: oklch(55% 0.12 70);\n  --color-warning-soft: oklch(96% 0.05 90);\n  --color-danger: oklch(52% 0.19 25);\n  --color-danger-soft: oklch(95% 0.03 25);\n  --color-info: oklch(50% 0.12 240);\n  --color-info-soft: oklch(95% 0.03 240);\n  --color-scrim: #00000066;\n  --color-link: oklch(52% 0.18 255);\n  --font-sans: \"Inter Variable\", Inter, ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\";\n  --font-mono: \"JetBrains Mono\", ui-monospace, monospace;\n  --text-xs: 0.75rem;\n  --text-xs--line-height: 1.333;\n  --text-sm: 0.875rem;\n  --text-sm--line-height: 1.25rem;\n  --text-base: 1rem;\n  --text-base--line-height: 1.5;\n  --text-base--font-weight: 400;\n  --text-base--letter-spacing: 0px;\n  --text-lg: 1.125rem;\n  --text-xl: 1.25rem;\n  --text-xl--line-height: 1.4;\n  --text-xl--font-weight: 600;\n  --text-2xl: 1.5rem;\n  --text-2xl--line-height: 1.333;\n  --text-3xl: 30px;\n  --text-3xl--line-height: 1.2;\n  --text-4xl: 2.25rem;\n  --text-4xl--line-height: 1.111;\n  --text-4xl--letter-spacing: -0.025rem;\n  --spacing: 0.25rem;\n  --radius-sm: 0.25rem;\n  --radius-md: 0.375rem;\n  --radius-lg: 8px;\n  --shadow-sm: 0px 1px 2px 0px #0000000d;\n  --shadow-md: 0px 4px 6px -1px oklch(0% 0 none / 0.1), 0px 2px 4px -2px oklch(0% 0 none / 0.1);\n  --shadow-lg: 0px 10px 15px -3px #0000001a;\n  --shadow-inner: inset 0px 2px 4px 0px #0000000d;\n}\n\n[data-theme='dark'] {\n  --color-background: oklch(18% 0.02 265);\n  --color-surface: oklch(23% 0.02 265);\n  --color-text: #f5f5f7;\n  --color-text-muted: oklch(75% 0.02 265);\n  --color-border: oklch(35% 0.02 265);\n  --color-primary: oklch(72% 0.15 255);\n  --color-on-primary: oklch(18% 0.02 265);\n  --color-danger: oklch(70% 0.3 25);\n  --color-danger-soft: oklch(28% 0.06 25);\n  --color-link: oklch(72% 0.15 255);\n  --shadow-md: 0px 4px 6px -1px oklch(0% 0 none / 0.5);\n}\n",
