{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__flai__.*",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(\"$CLAUDE_PROJECT_DIR\"/scripts/flai.sh guard 2>&1); [ $? -eq 2 ] || exit 0; echo \"$out\" >&2; exit 2"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$FLAI_ROLE\" = plan ] || [ \"$FLAI_ROLE\" = orchestrate ] || [ \"$FLAI_ROLE\" = analyze ] || exit 0; out=$(\"$CLAUDE_PROJECT_DIR\"/scripts/flai.sh guard 2>&1); [ $? -eq 2 ] || exit 0; echo \"$out\" >&2; exit 2"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$FLAI_STORY\" ] || exit 0; \"$CLAUDE_PROJECT_DIR\"/scripts/flai.sh guard >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$FLAI_STORY\" ] || exit 0; \"$CLAUDE_PROJECT_DIR\"/scripts/flai.sh guard >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ]
  }
}
